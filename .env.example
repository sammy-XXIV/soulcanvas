PORT=3000

# x402 payment (OKX Onchain OS Payment SDK)
X402_NETWORK=eip155:196
PAY_TO_ADDRESS=
# Private key for PAY_TO_ADDRESS — kept so funds can be moved out later; not
# read by the backend itself (payment settlement only needs the address).
PAY_TO_PRIVATE_KEY=
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
SOULCANVAS_PRICE_GENERATE=150000

# OpenAI (gpt-image-2)
OPENAI_API_KEY=

# Soulbound minting — deployer/minter wallet's private key, and the
# deployed contract address (see contracts/script/Deploy.s.sol)
MINTER_PRIVATE_KEY=
SOULBOUND_CONTRACT_ADDRESS=
XLAYER_RPC_URL=https://rpc.xlayer.tech

# Minted-metadata storage. In production this MUST be a mounted persistent
# volume path (e.g. Railway volume at /data) — the fallback "./data" is a
# relative path that only makes sense for local dev, and Railway containers
# are otherwise ephemeral, which would silently lose every minted NFT's
# metadata on the next redeploy.
DATA_DIR=./data
